---
/**
 * /kolektyw-na-start — onboarding guide for new clients of the Magic
 * collective: team, communication, materials, pace, reporting, boundaries.
 */
import { CircleArrow } from "@/components/ui"
import {
  GuideBand,
  GuideCard,
  GuideEdge,
  GuideHeader,
  GuideTitle,
  GuideTopic,
} from "@/components/kolektyw"
import {
  boundaries,
  community,
  contact,
  creation,
  firstSteps,
  guideFooter,
  guideHero,
  guideNav,
  meetUs,
  pace,
  reporting,
} from "@/data/kolektyw"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { cn } from "@/lib/cn"

const START_ID = "poczatek"

/** Round purple "next" marker between the guide blocks. */
const arrow = {
  size: "md",
  circleClass: "fill-plum",
  arrowClass: "stroke-cream",
  shape: "chevron",
} as const

/** Single column of topics used by most sections. */
const topicColumn = "relative z-10 mx-auto mt-12 grid w-full max-w-2xl gap-10 md:mt-16 md:gap-12"

/** Organic lavender blobs peeking in from the page edges. */
const blob =
  "absolute top-96 h-40 w-32 bg-lilac opacity-35 [border-radius:37%_63%_49%_51%/26%_33%_67%_74%] md:top-80 md:h-64 md:w-44 md:opacity-100 lg:h-80 lg:w-72"
---

<BaseLayout
  title="Kolektyw MAGIC. Zasady współpracy"
  description="Przewodnik po współpracy z kolektywem MAGIC: komunikacja, przygotowanie kampanii, materiały, raportowanie i pierwsze wspólne kroki."
  bodyClass="bg-cream text-black"
>
  <div class="overflow-hidden leading-tight">
    <GuideHeader nav={guideNav} home={`#${START_ID}`} />

    <main id={START_ID}>
      <section
        class="relative flex min-h-96 justify-center px-6"
        aria-labelledby="kolektyw-start-hero-title"
      >
        <div
          class="absolute inset-y-0 left-0 w-1/2 bg-art-checker opacity-60 md:w-1/3 md:opacity-100"
          aria-hidden="true"
        ></div>
        <div
          class="absolute inset-y-0 right-0 w-1/2 bg-art-checker opacity-60 md:w-1/3 md:opacity-100"
          aria-hidden="true"
        ></div>
        <div class="relative z-10 flex w-full max-w-lg flex-col items-center bg-cream/95 px-4 pt-14 pb-20 text-center md:bg-cream md:px-0 md:pt-16">
          <GuideTitle as="h1" hero id="kolektyw-start-hero-title">
            <Fragment set:html={guideHero.title} />
          </GuideTitle>
          <p class="mx-auto mt-6 w-full max-w-sm md:mt-7" set:html={guideHero.lead} />
          <CircleArrow {...arrow} class="absolute -bottom-16 left-1/2 -translate-x-1/2" />
        </div>
      </section>

      <section class="relative px-6 pt-28 pb-28 md:pb-36">
        <GuideTitle>{meetUs.title}</GuideTitle>
        <div class={topicColumn}>
          {meetUs.topics.map((topic) => (
            <GuideTopic topic={topic} />
          ))}
        </div>
        <span class={cn(blob, "-left-24 md:-left-32 lg:-left-36")} aria-hidden="true"></span>
        <span
          class={cn(blob, "-right-24 -scale-x-100 md:-right-32 lg:-right-36")}
          aria-hidden="true"
        ></span>
      </section>

      <section
        id={creation.id}
        class="bg-art-paper-grid px-4 pt-24 pb-28 md:px-6 md:pt-28 md:pb-40"
      >
        <GuideTitle>{creation.title}</GuideTitle>
        <div class="mx-auto mt-10 flex w-full max-w-3xl flex-col items-center">
          {creation.cards.map((card, index) => (
            <>
              {index > 0 && <CircleArrow {...arrow} class="my-6 md:my-8" />}
              <GuideCard card={card} />
            </>
          ))}
        </div>
      </section>

      <section id={contact.id} class="relative z-10 px-5 pt-20 pb-28 text-center md:pb-36">
        <h2
          class="mb-6 font-anton text-2xl leading-tight text-tangerine uppercase sm:text-3xl md:text-4xl"
          set:html={contact.title}
        />
        <a href={`mailto:${contact.email}`} class="text-lg underline underline-offset-4 md:text-xl">
          {contact.email}
        </a>
        <GuideEdge placement="below" />
      </section>

      <section>
        <GuideBand>
          <GuideTitle>{pace.title}</GuideTitle>
        </GuideBand>
        <div class={cn(topicColumn, "mt-0 px-6 pt-16 pb-32 md:mt-0 md:px-0 md:pt-20 md:pb-36")}>
          {pace.topics.map((topic) => (
            <GuideTopic topic={topic} />
          ))}
        </div>
      </section>

      <section class="relative z-10 bg-mint px-6 pt-36 pb-36 md:px-14 md:pt-40 md:pb-44">
        <GuideEdge placement="top" />
        <GuideTitle>
          <Fragment set:html={reporting.title} />
        </GuideTitle>
        <div class="mx-auto mt-14 grid w-full max-w-5xl gap-10 md:mt-16 md:grid-cols-2 md:gap-0">
          {reporting.topics.map((topic, index) => (
            <GuideTopic
              topic={topic}
              class={
                index === 0
                  ? "md:px-10"
                  : "border-t border-black/35 pt-10 md:border-t-0 md:border-l-2 md:px-10 md:pt-0"
              }
            />
          ))}
        </div>
        <GuideEdge placement="below" color="bg-mint" />
      </section>

      <section class="bg-art-paper-grid px-4 pt-44 pb-28 md:px-6 md:pt-48 md:pb-40">
        <GuideTitle>{community.title}</GuideTitle>
        <div class="mx-auto mt-10 w-full max-w-2xl">
          <GuideCard card={community.card} />
        </div>
      </section>

      <section>
        <GuideBand>
          <GuideEdge placement="top" class="h-20 md:h-32" />
          <GuideTitle>{boundaries.title}</GuideTitle>
        </GuideBand>
        <p class="mt-4 px-5 text-center" set:html={boundaries.note} />
        <div class="mx-auto mt-14 grid w-full max-w-5xl gap-10 px-6 pb-32 md:mt-20 md:grid-cols-3 md:px-8 lg:px-12 lg:pb-44">
          {boundaries.topics.map((topic) => (
            <GuideTopic topic={topic} />
          ))}
        </div>
      </section>

      <section class="relative bg-mint px-6 pt-36 pb-28 md:pt-40 md:pb-36">
        <GuideEdge placement="top" />
        <GuideTitle>{firstSteps.title}</GuideTitle>
        <div class={topicColumn}>
          {firstSteps.topics.map((topic) => (
            <GuideTopic topic={topic} />
          ))}
        </div>
      </section>
    </main>

    <footer class="px-6 pt-16 pb-20 text-center md:pt-20 md:pb-24">
      <p class="text-sm leading-snug italic" set:html={guideFooter} />
    </footer>
  </div>
</BaseLayout>
