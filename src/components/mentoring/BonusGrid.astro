---
/**
 * "🎁 Bonusy" block: gift emoji, a heading and rows of bonus tiles
 * (icon, rich-text description, optional value line).
 *
 * <BonusGrid heading="BONUSY:" rows={bonusRows} />
 */
import { Image } from "astro:assets"
import { cn } from "@/lib/cn"
import type { BonusItem } from "@/data/mentoring"

type Props = {
  heading: string
  rows: BonusItem[][]
  /** Large (default) or medium gift emoji. */
  gift?: "lg" | "md"
  class?: string
  headingClass?: string
}

const { heading, rows, gift = "lg", class: className, headingClass } = Astro.props
---

<div class={cn("flex flex-col items-center text-center", className)}>
  <p class={gift === "lg" ? "text-8xl" : "text-6xl"} aria-hidden="true">
    🎁
  </p>
  <h3 class={cn("mx-auto mb-14 max-w-fit bg-blush px-10 py-3 font-bold md:text-4xl", headingClass)}>
    {heading}
  </h3>
  {rows.map((row) => (
    <ul class="flex flex-col flex-wrap justify-center gap-4 md:flex-row md:gap-10">
      {row.map((item) => (
        <li class="flex flex-col items-center px-3 md:max-w-xs lg:min-w-60">
          <Image src={item.image} alt="" width={item.width} />
          <p class="pt-4 leading-snug" set:html={item.text} />
          {item.value && <p class="w-full px-2 pt-2 pb-10 leading-snug" set:html={item.value} />}
        </li>
      ))}
    </ul>
  ))}
</div>
