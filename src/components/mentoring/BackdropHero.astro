---
/**
 * Hero with a full-bleed photo background; the slot holds the copy.
 * The photo covers the whole band, so on mobile it stretches with the text.
 *
 * <BackdropHero image={bg} innerClass="items-start">…</BackdropHero>
 */
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { cn } from "@/lib/cn"

type Props = {
  image: ImageMetadata
  class?: string
  /** Classes for the content column (alignment, width, spacing). */
  innerClass?: string
}

const { image, class: className, innerClass } = Astro.props
---

<section class={cn("relative isolate overflow-hidden", className)}>
  <Image
    src={image}
    alt=""
    loading="eager"
    fetchpriority="high"
    widths={[640, 1280, 1920]}
    sizes="100vw"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <div class={cn("mx-auto flex flex-col px-3 pt-20 pb-10", innerClass)}>
    <slot />
  </div>
</section>
