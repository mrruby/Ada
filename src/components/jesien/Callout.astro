---
/** Pink-bordered blush highlight box of the Jesień landings. */
import { cn } from "@/lib/cn"

type Props = { class?: string }

const { class: className } = Astro.props
---

<div
  class={cn(
    "rounded-3xl border-2 border-jesien-pink bg-jesien-blush px-6 py-6 shadow-xl shadow-jesien-purple/15 md:px-7",
    className
  )}
>
  <slot />
</div>
