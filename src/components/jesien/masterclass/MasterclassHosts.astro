---
/** Masterclass: the two hosts. */
import { Image } from "astro:assets"
import { Container, Reveal } from "@/components/ui"
import { jesienMasterclassHosts } from "@/data/jesien"
import { cn } from "@/lib/cn"
import JesienHeading from "../JesienHeading.astro"
---

<section class="bg-white py-16 lg:py-20">
  <Container width="content" class="px-5">
    <Reveal class="text-center">
      <JesienHeading kicker="Kto prowadzi">
        Kto siedzi po drugiej stronie <span class="text-jesien-pink">ekranu</span> 👋
      </JesienHeading>
    </Reveal>

    <div class="mt-10 grid items-start gap-7 md:grid-cols-2">
      {jesienMasterclassHosts.map((host, index) => (
        <Reveal
          class={cn(
            "rounded-3xl px-7 pt-7 pb-8 shadow-xl shadow-jesien-purple/10",
            index % 2 ? "bg-jesien-blush" : "bg-jesien-lavender"
          )}
        >
          <Image
            src={host.photo}
            alt={host.alt ?? host.name}
            width={300}
            height={300}
            class="mb-4 size-36 rounded-full border-4 border-white bg-jesien-purple-soft object-cover shadow-lg shadow-jesien-ink/20"
          />
          <p class="text-2xl leading-tight font-extrabold">{host.name}</p>
          {host.role && <p class="mt-1 mb-4 font-bold text-jesien-purple">{host.role}</p>}
          {host.bio && (
            <p class="text-jesien-ink-soft [&_strong]:text-jesien-ink" set:html={host.bio} />
          )}
        </Reveal>
      ))}
    </div>
  </Container>
</section>
