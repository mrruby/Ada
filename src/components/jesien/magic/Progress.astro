---
/** "Co się zmieni po 1, 3 i 6 miesiącach?" — level track + three stages. */
import { magicStages } from "@/data/jesien"
import { cn } from "@/lib/cn"
import MjCard from "./MjCard.astro"
import MjHeading from "./MjHeading.astro"
import MjSection from "./MjSection.astro"

const levels = ["left-0", "left-1/5", "left-2/5", "left-3/5", "left-4/5", "left-full"]
const flagBase =
  "absolute bottom-full mb-2.5 rounded-full bg-jesien-ink px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-white after:absolute after:top-full after:-translate-x-1/2 after:border-6 after:border-transparent after:border-t-jesien-ink"
const flags = [
  { label: "1 miesiąc", class: "left-1/5 -translate-x-1/3 after:left-1/3" },
  { label: "3 miesiące", class: "left-3/5 -translate-x-1/2 after:left-1/2" },
  { label: "6 miesięcy", class: "left-full -translate-x-7/8 after:left-7/8" },
]
---

<MjSection id="postepy" tone="lavender">
  <MjHeading
    title="Co się zmieni po 1, 3 i 6 miesiącach?"
    accent="Wartość, którą widać w czasie."
  />

  <div class="mt-10 mb-9 px-3 pt-10 pb-4" aria-hidden="true">
    <div class="relative h-3.5 rounded-full border border-jesien-purple-soft/50 bg-white">
      <div class="absolute inset-0 rounded-full bg-linear-to-r from-periwinkle via-jesien-pink/60 to-marigold"></div>
      {levels.map((position, level) => (
        <span
          class={cn(
            "absolute top-1/2 grid size-7 -translate-1/2 place-items-center rounded-full border-2 border-jesien-ink bg-white text-xs font-semibold",
            position
          )}
        >
          {level}
        </span>
      ))}
      {flags.map((flag) => (
        <span class={cn(flagBase, flag.class)}>{flag.label}</span>
      ))}
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {magicStages.map((stage) => (
      <MjCard as="article" class="p-6">
        <div class="mb-3.5 grid size-11 place-items-center rounded-xl bg-blush/50 text-xl">
          {stage.emoji}
        </div>
        <h3 class="mb-0.5 text-xl font-semibold">{stage.title}</h3>
        <div class="mb-3.5 text-sm text-jesien-ink-soft">{stage.levels}</div>
        <ul class="grid gap-2">
          {stage.points.map((point) => (
            <li class="flex gap-2 text-sm text-jesien-ink-soft">
              <span class="font-bold text-jesien-purple" aria-hidden="true">
                ✓
              </span>
              {point}
            </li>
          ))}
        </ul>
        <div class="mt-4 text-sm font-semibold text-jesien-pink">{stage.tally}</div>
      </MjCard>
    ))}
  </div>
</MjSection>
