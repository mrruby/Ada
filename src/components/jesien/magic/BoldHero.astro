---
/**
 * /magic-jesien variant B hero: dark autumn-night band, oversized headline,
 * money/team/AI facts, the collage framed with stickers and a ticker of
 * members' results along the bottom edge.
 */
import { Image } from "astro:assets"
import hero from "@/assets/images/magic-jesien/hero.webp"
import { Marquee } from "@/components/ui"
import { magicBoldHero as copy, magicResults, magicResultsTicker } from "@/data/jesien"
import MjButton from "./MjButton.astro"

const spotlight = magicResults[2]
---

<header id="top" class="relative isolate overflow-hidden bg-jesien-ink text-white">
  <div
    class="pointer-events-none absolute -top-32 -left-32 -z-10 size-96 rounded-full bg-jesien-purple/60 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-1/3 -right-24 -z-10 size-80 rounded-full bg-jesien-pink/30 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-8 pb-16 md:grid-cols-12 md:pt-14 md:pb-20">
    <div class="md:col-span-7">
      <p class="inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-semibold tracking-widest uppercase">
        {copy.eyebrow}
      </p>
      <h1 class="mt-6 animate-settle text-5xl leading-none font-extrabold tracking-tight text-balance md:text-6xl lg:text-7xl">
        {copy.title}
        <em class="mt-3 block">{copy.accent}</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-snug text-white/80 lg:text-xl">{copy.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <MjButton href="#pakiety" size="lg">
          {copy.primary}
        </MjButton>
        <MjButton
          href="#wideo"
          variant="outline"
          class="border-white/40 bg-transparent text-white hover:border-white"
        >
          {copy.secondary}
        </MjButton>
      </div>
      <ul class="mt-10 grid gap-3 sm:grid-cols-3">
        {copy.facts.map((fact) => (
          <li class="rounded-2xl border border-white/15 bg-white/5 p-4">
            <b class="block text-2xl font-extrabold tracking-tight text-marigold">{fact.value}</b>
            <span class="mt-1 block text-sm leading-snug text-white/75">{fact.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md md:col-span-5">
      <div class="rotate-2 rounded-4xl bg-linear-160 from-lavender via-blush to-jesien-orange-soft p-3 shadow-2xl shadow-black/40">
        <Image
          src={hero}
          alt={copy.imageAlt}
          widths={[480, 800, 1000]}
          sizes="(min-width: 1152px) 448px, (min-width: 768px) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full rounded-3xl"
        />
      </div>
      <span class="absolute -top-4 -left-2 -rotate-6 rounded-full bg-lemon px-4 py-2 text-sm font-extrabold text-jesien-ink shadow-lg">
        ★ {copy.sticker}
      </span>
      <div class="absolute -right-2 -bottom-8 rotate-3 rounded-2xl bg-white px-4 py-3 text-jesien-ink shadow-xl shadow-black/30">
        <span class="block text-xs text-jesien-ink-soft">{spotlight.campaign}</span>
        <b class="block text-lg leading-tight">
          <span class="text-3xl text-jesien-pink">{spotlight.value}</span> {spotlight.unit}
        </b>
        <span class="block text-xs text-jesien-ink-soft">{spotlight.rows[1].join(": ")}</span>
      </div>
    </div>
  </div>

  <Marquee duration={50} class="bg-marigold py-3 text-jesien-ink" trackClass="gap-8 pr-8">
    {magicResultsTicker.map((item) => (
      <span class="font-bold whitespace-nowrap">✦ {item}</span>
    ))}
  </Marquee>
</header>
