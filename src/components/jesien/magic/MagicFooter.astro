---
import { Image } from "astro:assets"
import logo from "@/assets/images/magic-jesien/logo.webp"
import { social } from "@/config/site"
import { newTabProps } from "@/lib/links"

const links = [
  { label: "@klub.magic", href: "https://www.instagram.com/klub.magic/", external: true },
  { label: "@adapromis", href: social.instagram, external: true },
  { label: "Subskrypcje", href: "#pakiety" },
  { label: "FAQ", href: "#faq" },
  { label: "Polityka prywatności", href: "/policy/" },
  { label: "Regulamin", href: "/terms/" },
]
---

<footer class="bg-lavender pt-10 pb-8 text-sm text-jesien-ink-soft">
  <div class="mx-auto flex max-w-6xl flex-wrap items-start justify-between gap-x-8 gap-y-5 px-5">
    <div>
      <Image src={logo} alt="MAGIC" width={237} class="mb-2.5 block h-auto w-28" />
      Marketing Ads Girls Inside Club.
    </div>
    <nav class="flex max-w-2xl flex-wrap gap-5">
      {links.map(({ label, href, external }) => (
        <a href={href} {...(external ? newTabProps : {})} class="font-medium text-jesien-ink">
          {label}
        </a>
      ))}
    </nav>
    <p class="w-full border-t border-jesien-ink/10 pt-5 text-center">
      © 2026 Slow Marketing Adrianna Promis-Urbas. Wszystkie prawa zastrzeżone.
    </p>
  </div>
</footer>
