---
/**
 * Call-to-action. Renders an <a> when `href` is set (internal paths, #anchors,
 * external URLs, /api/ endpoints), otherwise a <button>.
 *
 * Pick a `variant` + `size`, then fine-tune with `class` — conflicting
 * Tailwind classes passed in `class` win over the defaults.
 */
import type { HTMLAttributes } from "astro/types"
import { cn } from "@/lib/cn"
import { isExternal, newTabProps } from "@/lib/links"

const variants = {
  /** Classic Ada: lavender block, pink on hover. */
  soft: "bg-lavender text-navy hover:bg-rose hover:shadow-xl",
  /** Classic Ada with a navy outline (about page cards). */
  outline: "border border-navy bg-lavender text-navy hover:bg-rose",
  /** Black pill with yellow label (Magic / training landings). */
  dark: "rounded-full bg-black text-lemon shadow-xl hover:brightness-125",
  /** Small black label button used on cards ("WYBIERAM!"). */
  black: "rounded-md bg-black uppercase text-white hover:bg-neutral-700",
  /** Pink pill (Magic club CTAs). */
  pill: "rounded-full bg-bubblegum text-black tracking-wide shadow-xl hover:opacity-90",
  /** Orange offer button. */
  offer: "rounded-xl bg-marigold text-black shadow-md hover:shadow-xl hover:brightness-95",
  /** Hot pink offer button. */
  pink: "rounded-xl bg-magenta text-white shadow-md hover:shadow-xl hover:brightness-95",
  /** No visual styles — supply everything via `class`. */
  bare: "",
} as const

const sizes = {
  sm: "px-4 py-1 text-sm",
  md: "px-5 py-2 text-base",
  lg: "px-8 py-3 text-lg md:text-xl",
  xl: "px-10 py-4 text-xl md:text-2xl",
  none: "",
} as const

export type ButtonVariant = keyof typeof variants
export type ButtonSize = keyof typeof sizes

type Props = Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> & {
  href?: string
  variant?: ButtonVariant
  size?: ButtonSize
  type?: "button" | "submit" | "reset"
  /** Open an external link in a new tab. */
  newTab?: boolean
}

const {
  href,
  variant = "soft",
  size = "md",
  type = "button",
  newTab = false,
  class: className,
  ...attrs
} = Astro.props

const classes = cn(
  "inline-flex items-center justify-center gap-2 text-center font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current",
  variants[variant],
  sizes[size],
  className
)
const tabProps = newTab && href && isExternal(href) ? newTabProps : {}
---

{href ? (
  <a href={href} class={classes} {...tabProps} {...attrs}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...attrs}>
    <slot />
  </button>
)}
