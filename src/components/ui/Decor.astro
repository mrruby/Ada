---
/**
 * Decorative artwork (flowers, suns, waves…) from src/assets/images/decor.
 * Position it relative to the section it decorates — the parent needs
 * `relative` (and usually `overflow-hidden`):
 *
 *   <Section bg="bg-lavender" class="relative overflow-hidden">
 *     <Decor art="flower-left-blue" class="top-10 -left-16 hidden md:block" />
 *     …
 *   </Section>
 */
import flowerBlue from "@/assets/images/decor/flower-blue.svg"
import flowerBottom from "@/assets/images/decor/flower-bottom.svg"
import flowerLeftBlue from "@/assets/images/decor/flower-left-blue.svg"
import flowerRightWhite from "@/assets/images/decor/flower-right-white.svg"
import magicSunYellow from "@/assets/images/decor/magic-sun-yellow.svg"
import sun from "@/assets/images/decor/sun.svg"
import twoFlowers from "@/assets/images/decor/two-flowers.svg"
import waves1 from "@/assets/images/decor/waves1.svg"
import { cn } from "@/lib/cn"

const art = {
  "flower-blue": flowerBlue,
  "flower-bottom": flowerBottom,
  "flower-left-blue": flowerLeftBlue,
  "flower-right-white": flowerRightWhite,
  "magic-sun-yellow": magicSunYellow,
  sun,
  "two-flowers": twoFlowers,
  "waves-1": waves1,
}

type DecorArt = keyof typeof art

type Props = {
  art: DecorArt
  class?: string
  width?: number
  height?: number
}

const { art: name, class: className, width, height } = Astro.props
---

<img
  src={art[name].src}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
  width={width}
  height={height}
  class={cn("pointer-events-none absolute select-none", className)}
/>
