---
/**
 * Decorative artwork (flowers, suns, waves…) from /public/assets.
 * Position it relative to the section it decorates — the parent needs
 * `relative` (and usually `overflow-hidden`):
 *
 *   <Section bg="bg-lavender" class="relative overflow-hidden">
 *     <Decor art="flower-left-blue" class="top-10 -left-16 hidden md:block" />
 *     …
 *   </Section>
 */
import { cn } from "@/lib/cn"

const art = {
  "flower-blue": "/assets/flower-blue.svg",
  "flower-bottom": "/assets/flower-bottom.svg",
  "flower-left-blue": "/assets/flower-left-blue.svg",
  "flower-right-white": "/assets/flower-right-white.svg",
  "magic-sun-yellow": "/assets/magic-sun-yellow.svg",
  sun: "/assets/sun.svg",
  "two-flowers": "/assets/two-flowers.svg",
  "waves-1": "/assets/waves1.svg",
} as const

export type DecorArt = keyof typeof art

type Props = {
  art: DecorArt
  class?: string
  width?: number
  height?: number
}

const { art: name, class: className, width, height } = Astro.props
---

<img
  src={art[name]}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
  width={width}
  height={height}
  class={cn("pointer-events-none absolute select-none", className)}
/>
