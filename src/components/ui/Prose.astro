---
/** Typography for long-form rendered Markdown/HTML (legal pages, articles). */
import { cn } from "@/lib/cn"

type Props = { class?: string }
const { class: className } = Astro.props
---

<div
  class={cn(
    "[&_a]:font-semibold [&_a]:underline [&_h1]:py-3 [&_h1]:text-2xl [&_h1]:font-bold [&_h2]:py-3 [&_h2]:font-bold md:[&_h2]:text-2xl [&_h3]:py-3 [&_h3]:font-bold [&_h4]:py-3 [&_h4]:font-bold [&_ol]:list-decimal [&_ol]:pb-4 [&_ol]:pl-6 [&_p]:pb-4 [&_ul]:list-disc [&_ul]:pb-4 [&_ul]:pl-6",
    className
  )}
>
  <slot />
</div>
