---
/**
 * Vimeo/YouTube embed behind a poster. The player (and its cookies) loads only
 * with the visitor's `media` consent: clicking play without it shows a short
 * notice with "allow and play" and a link to watch on the provider's site.
 * `eager` loads the player right away once consent exists (e.g. course videos).
 *
 * <VideoEmbed provider="vimeo" id="1150047798" title="Opinia Ani" aspect="9:16" />
 */
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { cn } from "@/lib/cn"

const aspects = {
  "16:9": "aspect-video",
  "9:16": "aspect-9/16",
  "4:5": "aspect-4/5",
  "1:1": "aspect-square",
} as const

type Props = {
  provider?: "vimeo" | "youtube"
  /** Video id (any `?query` suffix is ignored). */
  id: string
  title: string
  aspect?: keyof typeof aspects
  /** Custom poster; defaults to the provider thumbnail. */
  poster?: ImageMetadata | string
  /** Extra player query params, e.g. "loop=1&muted=1". */
  params?: string
  /** Load the player without a click once media consent exists. */
  eager?: boolean
  /** Autoplay when loaded eagerly (muted autoplay is the only reliable kind). */
  autoplay?: boolean
  class?: string
  /** Image `sizes` hint for the poster. */
  sizes?: string
}

const {
  provider = "vimeo",
  id: rawId,
  title,
  aspect = "16:9",
  poster,
  params = "",
  eager = false,
  autoplay = false,
  class: className,
  sizes = "(max-width: 640px) 100vw, 640px",
} = Astro.props

const id = rawId.split("?")[0]
const providerName = provider === "vimeo" ? "Vimeo" : "YouTube"

const playerUrl = (play: boolean) => {
  const query = new URLSearchParams(params)
  if (provider === "vimeo") {
    query.set("badge", "0")
    query.set("autopause", "0")
    query.set("player_id", "0")
    query.set("app_id", "58479")
    // Vimeo's do-not-track mode: no session tracking or analytics cookies.
    query.set("dnt", "1")
  } else {
    query.set("rel", "0")
  }
  if (play) query.set("autoplay", "1")
  const base =
    provider === "vimeo"
      ? `https://player.vimeo.com/video/${id}`
      : `https://www.youtube-nocookie.com/embed/${id}`
  return `${base}?${query.toString()}`
}

const watchUrl =
  provider === "vimeo" ? `https://vimeo.com/${id}` : `https://www.youtube.com/watch?v=${id}`
const remotePoster =
  provider === "vimeo"
    ? `https://vumbnail.com/${id}_large.jpg`
    : `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
const remoteSrcset =
  provider === "vimeo"
    ? `https://vumbnail.com/${id}_small.jpg 320w, https://vumbnail.com/${id}_medium.jpg 640w, https://vumbnail.com/${id}_large.jpg 1280w`
    : undefined
---

<div
  class={cn("relative w-full overflow-hidden bg-black", aspects[aspect], className)}
  data-consent-embed
  data-src={playerUrl(true)}
  data-eager-src={eager ? playerUrl(autoplay) : undefined}
  data-title={title}
  data-allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
>
  <button
    type="button"
    class="group absolute inset-0 h-full w-full"
    aria-label={`Odtwórz wideo: ${title}`}
    data-embed-play
  >
    {poster && typeof poster !== "string" ? (
      <Image
        src={poster}
        alt=""
        class="h-full w-full object-cover"
        widths={[320, 640, 960]}
        sizes={sizes}
      />
    ) : (
      <img
        src={typeof poster === "string" ? poster : remotePoster}
        srcset={typeof poster === "string" ? undefined : remoteSrcset}
        sizes={sizes}
        alt=""
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    )}
    <span class="absolute top-1/2 left-1/2 flex size-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 transition-colors group-hover:bg-black/85">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="white" class="ml-1" aria-hidden="true">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </span>
  </button>
  <div
    data-embed-prompt
    hidden
    class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/85 p-4 text-center text-white"
    role="group"
    aria-label={`Zgoda na odtworzenie: ${title}`}
  >
    <p class="max-w-xs text-xs leading-snug sm:text-sm">
      Film odtwarza się z serwisu {providerName}, który może zapisywać pliki cookie.
    </p>
    <button
      type="button"
      data-embed-accept
      class="rounded-full bg-white px-4 py-2 text-xs font-bold text-black hover:bg-lavender sm:text-sm"
    >
      Zgadzam się, odtwórz
    </button>
    <a href={watchUrl} target="_blank" rel="noopener noreferrer" class="text-xs underline">
      Obejrzyj na {providerName}
    </a>
  </div>
</div>

<script>
  import { initConsentEmbeds } from "@/lib/embeds"

  initConsentEmbeds()
</script>
