---
/** Lavender bar pinned to the top: offer deadline countdown + CTA. */
import { Button, TileCountdown } from "@/components/ui"
import { MAGIC_OFFER_DEADLINE, MAGIC_PACKAGE_HREF } from "@/data/magic"

type Props = {
  target?: string
  label?: string
}

const {
  target = MAGIC_OFFER_DEADLINE,
  label = "🔥 Oferta dla listy zainteresowanych – tylko do:",
} = Astro.props
---

<div class="sticky top-0 z-50 bg-periwinkle px-4 py-2">
  <div class="container mx-auto flex flex-wrap items-center justify-center gap-2 md:gap-6">
    <span class="text-center text-xs font-semibold text-white sm:text-sm md:text-lg">{label}</span>
    <TileCountdown target={target} tone="bg-bubblegum text-black" />
    <Button
      href={MAGIC_PACKAGE_HREF}
      variant="pill"
      size="none"
      class="px-5 py-2 text-sm font-bold shadow-none md:text-base"
    >
      Dołączam!
    </Button>
  </div>
</div>
