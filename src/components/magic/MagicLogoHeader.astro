---
/** Slim header with the Magic logo (landing pages without site navigation). */
import logo from "@/assets/images/decor/magic-2.svg"
---

<header class="bg-petal-light px-6 py-4 md:px-12">
  <div class="container mx-auto">
    <img
      src={logo.src}
      alt="Magic"
      width="192"
      height="48"
      decoding="async"
      class="h-12 w-auto"
    />
  </div>
</header>
