---
/** "Kim jesteśmy?" — the collective's team in two columns, optional mascot below. */
import { Section } from "@/components/ui"
import type { TeamMember as Member } from "@/lib/content"
import KolektywTitle from "./KolektywTitle.astro"
import TeamMember from "./TeamMember.astro"

type Props = {
  members: Member[]
  /** Shown centered under the team (the office cat). */
  mascot?: Member
  title?: string
  bg?: string
}

const { members, mascot, title = "Kim jesteśmy?", bg = "bg-mint" } = Astro.props
---

<Section bg={bg}>
  <div class="mx-auto max-w-6xl px-4 py-8 text-center md:py-12">
    <KolektywTitle tone="clear" class="max-w-xs">
      {title}
    </KolektywTitle>
    <div class="grid justify-center gap-x-4 gap-y-8 pt-8 md:grid-cols-2">
      {members.map((member) => (
        <TeamMember member={member} />
      ))}
    </div>
    {mascot && (
      <div class="mt-8 mb-8">
        <TeamMember member={mascot} centered />
      </div>
    )}
  </div>
</Section>
