---
/** /magic-kolektyw hero: logo, claim, CTA and photo over a half checkered band. */
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import cursor from "@/assets/images/magicArrow.svg"
import { Section } from "@/components/ui"
import type { LinkItem, RichText } from "@/lib/content"
import CollectiveLogo from "./CollectiveLogo.astro"
import KolektywButton from "./KolektywButton.astro"

type Props = {
  title: string
  lead: RichText
  cta: LinkItem
  photo: { src: ImageMetadata; alt: string }
}

const { title, lead, cta, photo } = Astro.props
---

<Section bg="bg-cream" class="relative overflow-hidden text-black">
  <div class="bg-art-pink-half" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex max-w-5xl flex-col items-center justify-center gap-8 px-4 py-8 sm:pt-16 md:flex-row md:items-start md:px-8 md:pb-0">
    <div class="mt-2 w-full md:w-1/2">
      <CollectiveLogo href="/" eager />
      <h1 class="mb-4 pt-4 text-2xl md:pt-8 md:text-3xl">{title}</h1>
      <p class="mb-6 font-courier text-sm leading-relaxed md:text-base" set:html={lead} />
      <KolektywButton href={cta.href} variant="mint" class="mb-2 py-3 md:mb-8 md:py-4 md:text-2xl">
        {cta.label}
      </KolektywButton>
      <Image src={cursor} alt="" width={22} height={34} class="mt-10 -ml-2 inline-block" />
    </div>
    <div class="mb-4 flex w-full justify-center md:w-1/2 md:justify-end">
      <Image
        src={photo.src}
        alt={photo.alt}
        width={458}
        height={498}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full max-w-md"
      />
    </div>
  </div>
</Section>
