---
/** /kolektyw-rozmowa hero: "Jeśli..." pill, problem statement and a portrait. */
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { CircleArrow, Section } from "@/components/ui"
import CollectiveLogo from "./CollectiveLogo.astro"
import KolektywTitle from "./KolektywTitle.astro"

type Props = {
  title: string
  lead: string
  text: string
  photo: { src: ImageMetadata; alt: string }
}

const { title, lead, text, photo } = Astro.props
---

<Section bg="bg-cream" class="relative z-10 text-black">
  <div class="mx-auto max-w-5xl px-1">
    <div class="flex justify-end">
      <CollectiveLogo eager />
    </div>
    <div class="-mt-10 flex w-full flex-col items-center gap-2 px-3 md:flex-row">
      <Image
        src={photo.src}
        alt={photo.alt}
        width={400}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="relative z-10 h-auto w-full max-w-sm"
      />
      <div>
        <KolektywTitle as="h1" size="xl" class="mx-0 max-w-xs uppercase">
          {title}
        </KolektywTitle>
        <div class="flex max-w-xl flex-col gap-4 text-lg">
          <p class="mt-10 font-bold">{lead}</p>
          <p class="mb-4">{text}</p>
        </div>
      </div>
    </div>
  </div>
  <CircleArrow
    size="lg"
    circleClass="fill-plum"
    arrowClass="stroke-petal"
    shape="chevron"
    class="pointer-events-none absolute bottom-0 left-1/2 z-20 -translate-x-1/2 translate-y-1/2"
  />
</Section>
