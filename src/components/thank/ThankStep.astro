---
/**
 * Numbered step on the thank-you page. The number sits in a triangle that
 * "hangs" from the previous band, so `tabColor` should match that band.
 */
import { Section } from "@/components/ui"
import { cn } from "@/lib/cn"

type Props = {
  step: number
  /** Background of this band. */
  bg: string
  /** Text color class used as the triangle fill (match the previous band). */
  tabColor: string
  numberClass?: string
  class?: string
}

const { step, bg, tabColor, numberClass = "text-tangerine", class: className } = Astro.props
---

<Section bg={bg}>
  <div
    class={cn(
      "flex flex-col items-center px-2 pb-12 text-center text-xs text-black md:text-2xl",
      className
    )}
  >
    <div class="relative mb-6 flex h-24 w-72 items-center justify-center">
      <svg
        viewBox="0 0 300 100"
        class={cn("absolute inset-0 size-full fill-current", tabColor)}
        aria-hidden="true"
      >
        <path d="M0 0h300L150 100z"></path>
      </svg>
      <span class={cn("relative -mt-6 font-anton text-2xl md:text-5xl", numberClass)}>{step}</span>
    </div>
    <slot />
  </div>
</Section>
