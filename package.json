{
  "name": "adrianna-promis-astro",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Adrianna Promis-Urbas website rebuilt on Astro",
  "author": "Adrianna Promis <adrianna@getbold.agency>",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,css,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PUBLIC_POSTHOG_KEY=phc_e2e astro build && playwright test",
    "test:e2e:dist": "playwright test",
    "test:a11y": "PUBLIC_POSTHOG_KEY=phc_e2e astro build && playwright test tests/e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.6",
    "@netlify/blobs": "10.7.9",
    "astro": "^7.3.5",
    "posthog-js": "^1.438.1",
    "sharp": "^0.35.5",
    "stripe": "22.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/runtime": "^1.11.3",
    "@netlify/plugin-lighthouse": "^6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "resolutions": {
    "sharp": "^0.35.5"
  }
}
