# PostHog project key (EU Cloud). Set it in Netlify for the Production context
# only (Builds scope), so deploy previews don't send analytics. Empty = off.
PUBLIC_POSTHOG_KEY=
# OTO (one-time offer) checkout for /wyzwanie — used by /api/oto/* endpoints
OTO_WYZWANIE_EASY_CHECKOUT_URL=
OTO_WYZWANIE_REGULAR_CHECKOUT_URL=
STRIPE_SECRET_KEY=
STRIPE_WYZWANIE_OTO_COUPON_ID=
OTO_TOKEN_SECRET=
OTO_COOKIE_SECRET=
# Optional outside Netlify runtime (local dev against a real blob store)
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
# Contact form reCAPTCHA site key (optional; without it Netlify's own reCAPTCHA is used)
SITE_RECAPTCHA_KEY=
