---
/**
 * One campaign result: a giant headline figure, a breakdown written as
 * sentence-like rows of text, emoji and handwritten (typed) numbers, and a
 * closing remark. Optionally ends with a round arrow to the application form.
 */
import type { CampaignResult, ResultToken } from "@/data/kolektyw/types"
import { CircleArrow, Section } from "@/components/ui"
import { cn } from "@/lib/cn"
import HandValue from "./HandValue.astro"

type Props = {
  result: CampaignResult
  /** Anchor of the arrow under the box (when `result.arrow`). */
  next?: string
  bg?: string
}

const { result, next, bg = "bg-cream" } = Astro.props
const box = cn(
  "rounded-3xl border border-tangerine px-12 py-4 text-lg",
  result.tone === "green" ? "bg-mint" : "bg-cream"
)
const hasLabel = (row: ResultToken[]) => row.some((token) => token.kind === "value" && token.label)
---

<Section bg={bg} class="text-black">
  <div class="relative mx-auto max-w-4xl px-8 pt-20 pb-16 text-center md:px-4 md:pt-24">
    <div class={box}>
      {result.subtitle && <p set:html={result.subtitle} />}
      <p class="font-anton text-4xl leading-tight text-tangerine md:text-9xl md:leading-normal">
        {result.title}
      </p>
      {result.caption && <p set:html={result.caption} />}
    </div>

    <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 py-6">
      {result.rows.map((row) => (
        <div
          class={cn(
            "flex flex-wrap justify-center gap-x-3 gap-y-1",
            hasLabel(row) ? "items-center" : "items-baseline"
          )}
        >
          {row.map((token) =>
            token.kind === "emoji" ? (
              <span
                class={cn(
                  "inline-block text-6xl leading-none md:text-7xl",
                  token.rotate && "-rotate-90"
                )}
                aria-hidden="true"
              >
                {token.value}
              </span>
            ) : token.kind === "text" ? (
              <p class={cn("md:text-lg", token.narrow && "max-w-xs")} set:html={token.html} />
            ) : token.label ? (
              <div class="flex flex-col text-left">
                <p class="text-lg">{token.label}</p>
                <HandValue value={token.value} />
              </div>
            ) : (
              <HandValue value={token.value} />
            )
          )}
        </div>
      ))}
    </div>

    <div class={box} set:html={result.summary} />

    {result.arrow && next && (
      <CircleArrow
        href={next}
        size="lg"
        circleClass="fill-plum"
        arrowClass="stroke-petal"
        shape="chevron"
        label="Przejdź do formularza konsultacji"
        class="absolute bottom-0 left-1/2 z-20 -translate-x-1/2 translate-y-1/2"
      />
    )}
  </div>
</Section>
