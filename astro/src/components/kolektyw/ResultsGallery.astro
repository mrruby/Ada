---
/** "Nasze wyniki w liczbach" — annotated ads-manager screenshots, revealed on scroll. */
import { Image } from "astro:assets"
import { Reveal, Section } from "@/components/ui"
import type { ImageItem } from "@/lib/content"
import KolektywTitle from "./KolektywTitle.astro"

type Props = {
  title: string
  images: ImageItem[]
  bg?: string
}

const { title, images, bg = "bg-mint" } = Astro.props
---

<Section bg={bg} class="text-black">
  <div class="mx-auto max-w-5xl px-3 py-12">
    <KolektywTitle class="max-w-md">{title}</KolektywTitle>
    <div class="flex flex-col gap-20 py-10">
      {images.map((image) => (
        <Reveal>
          <Image
            src={image.src}
            alt={image.alt}
            widths={[640, 1024, 1360]}
            sizes="(min-width: 1024px) 1024px, 100vw"
            class="h-auto w-full"
          />
        </Reveal>
      ))}
    </div>
  </div>
</Section>
