---
/** /jesien-nagranie: video testimonials of Magic members. */
import { Container, Reveal } from "@/components/ui"
import { CaseStudyVideos } from "@/components/sections"
import JesienHeading from "../JesienHeading.astro"
---

<section class="bg-white py-16 lg:py-20">
  <Container width="content" class="px-5">
    <Reveal class="mx-auto max-w-2xl text-center">
      <JesienHeading kicker="Opinie klubowiczek">
        Posłuchaj dziewczyn z <span class="text-jesien-pink">MAGIC</span> 💜
      </JesienHeading>
    </Reveal>
  </Container>
  <Reveal>
    <CaseStudyVideos class="mx-auto max-w-7xl px-6 py-12 md:px-12" />
  </Reveal>
</section>
