---
/**
 * List whose items are led by an icon — an emoji / glyph string ("✓", "🔥")
 * or an image (e.g. a check SVG). Item text is trusted HTML.
 *
 *   <IconList items={["Pierwszy punkt", "Drugi"]} icon="✓" />
 *   <IconList items={[{ icon: "🔥", text: "…" }, …]} columns={2} />
 *   <IconList items={[leftColumn, rightColumn]} icon={checkSvg} />
 *
 * `items` may be one flat list (optionally split into `columns`) or an array
 * of explicit columns. Icons inherit the text size; set `iconClass` to change.
 */
import type { ImageMetadata } from "astro"
import { cn } from "@/lib/cn"
import Item from "./IconListItem.astro"
import type { RichText } from "@/lib/content"

export type IconListItem = RichText | { icon?: string | ImageMetadata; text: RichText }
type Icon = string | ImageMetadata

type Props = {
  items: IconListItem[] | IconListItem[][]
  /** Default icon for items that don't set their own. */
  icon?: Icon
  /** Split a flat list into this many columns (from md). */
  columns?: 1 | 2 | 3
  /** Stack the icon above the text. */
  stacked?: boolean
  /** Icon flows with the text like a first character (no hanging indent). */
  inline?: boolean
  class?: string
  columnClass?: string
  itemClass?: string
  iconClass?: string
  textClass?: string
}

const {
  items,
  icon: defaultIcon,
  columns = 1,
  stacked = false,
  inline = false,
  class: className,
  columnClass,
  itemClass,
  iconClass,
  textClass,
} = Astro.props

const isGrouped = Array.isArray(items[0])
const flat = items as IconListItem[]
const perColumn = Math.ceil(flat.length / columns)
const groups: IconListItem[][] = isGrouped
  ? (items as IconListItem[][])
  : Array.from({ length: columns }, (_, index) =>
      flat.slice(index * perColumn, (index + 1) * perColumn)
    ).filter((group) => group.length > 0)

const shared = { inline, stacked, itemClass, iconClass, textClass }
const normalize = (item: IconListItem) => ({
  ...shared,
  ...(typeof item === "string"
    ? { icon: defaultIcon, text: item }
    : { icon: item.icon ?? defaultIcon, text: item.text }),
})
---

{
  /* One column: the <ul> itself takes `class` (then `columnClass`). */
  groups.length === 1 ? (
    <ul class={cn("flex flex-col gap-3", className, columnClass)}>
      {groups[0].map(normalize).map((item) => (
        <Item {...item} />
      ))}
    </ul>
  ) : (
    <div class={cn("flex flex-col gap-4 md:flex-row md:justify-center md:gap-8", className)}>
      {groups.map((group) => (
        <ul class={cn("flex flex-col gap-3", columnClass)}>
          {group.map(normalize).map((item) => (
            <Item {...item} />
          ))}
        </ul>
      ))}
    </div>
  )
}
