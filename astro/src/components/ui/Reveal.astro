---
/**
 * Fades/slides content in when it scrolls into view. Content that is already
 * on screen, visitors with reduced motion, and no-JS visitors see it at once.
 */
import type { HTMLAttributes } from "astro/types"
import { cn } from "@/lib/cn"

type Props = HTMLAttributes<"div"> & {
  as?: "div" | "li" | "section" | "article"
  /** Direction the content slides in from. */
  from?: "bottom" | "left" | "right"
}

const { as: Tag = "div", from = "bottom", class: className, ...attrs } = Astro.props
---

<Tag class={cn("reveal", className)} data-reveal data-reveal-from={from} {...attrs}>
  <slot />
</Tag>

<style is:global>
  .reveal {
    transition:
      opacity 600ms ease-out,
      transform 600ms ease-out;
  }
  .reveal[data-reveal="pending"] {
    opacity: 0;
    transform: translateY(22px);
  }
  .reveal[data-reveal="pending"][data-reveal-from="left"] {
    transform: translateX(-48px);
  }
  .reveal[data-reveal="pending"][data-reveal-from="right"] {
    transform: translateX(48px);
  }
</style>

<script>
  const nodes = document.querySelectorAll<HTMLElement>("[data-reveal]")
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  if (!reduce && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          ;(entry.target as HTMLElement).dataset.reveal = "done"
          observer.unobserve(entry.target)
        }
      },
      { threshold: 0.14 }
    )
    nodes.forEach((node) => {
      if (node.getBoundingClientRect().top < window.innerHeight) return
      node.dataset.reveal = "pending"
      observer.observe(node)
    })
  }
</script>
