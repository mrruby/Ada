---
/**
 * FAQ: heading + one or two columns of accordions.
 * Slots: "title" (overrides `title`), default (content after the list).
 */
import { Accordion, Section } from "@/components/ui"
import type { SectionWidth } from "@/components/ui/Section.astro"
import { cn } from "@/lib/cn"
import type { FaqItem } from "@/lib/content"

type Props = {
  items: FaqItem[]
  title?: string
  columns?: 1 | 2
  variant?: "classic" | "outlined" | "minimal"
  bg?: string
  width?: SectionWidth
  id?: string
  class?: string
  /** Overrides the inner column padding. */
  innerClass?: string
  titleClass?: string
  listClass?: string
  itemClass?: string
  /** Classes for each question row. */
  summaryClass?: string
}

const {
  items,
  title = "FAQ",
  columns = 2,
  variant = "classic",
  bg,
  width = "container",
  id = "faq",
  class: className,
  innerClass,
  titleClass,
  listClass,
  itemClass,
  summaryClass,
} = Astro.props

const half = Math.ceil(items.length / 2)
const groups = columns === 2 ? [items.slice(0, half), items.slice(half)] : [items]
---

<Section
  bg={bg}
  width={width}
  id={id}
  class={className}
  innerClass={cn("px-6 py-12 md:py-16", innerClass)}
>
  {Astro.slots.has("title") ? (
    <slot name="title" />
  ) : (
    <h2 class={cn("mb-8 text-center text-xl font-bold lg:text-5xl", titleClass)}>{title}</h2>
  )}
  <div
    class={cn(
      "mx-auto grid gap-x-16 gap-y-4",
      columns === 2 ? "max-w-6xl lg:grid-cols-2" : "max-w-3xl",
      listClass
    )}
  >
    {groups.map((group) => (
      <ul class="flex flex-col gap-4">
        {group.map((item) => (
          <li>
            <Accordion
              question={item.question}
              variant={variant}
              class={itemClass}
              summaryClass={summaryClass}
            >
              <div set:html={item.answer} />
            </Accordion>
          </li>
        ))}
      </ul>
    ))}
  </div>
  <slot />
</Section>
