---
/** Campaign numbers of a case study as label/value pairs. */
import type { CaseStat } from "@/data/masterclass"

type Props = { stats: CaseStat[]; class?: string }

const { stats, class: className } = Astro.props
---

<dl class={className}>
  {stats.map((stat) => (
    <div class="pb-2">
      <dt class="pt-1 font-bold">{stat.label}</dt>
      <dd>{stat.value}</dd>
    </div>
  ))}
</dl>
