---
/**
 * Contact form handled by Netlify Forms (detected in the static HTML).
 * reCAPTCHA: with a site key configured (PUBLIC_SITE_RECAPTCHA_KEY, or the
 * Netlify-side SITE_RECAPTCHA_KEY / legacy GATSBY_SITE_RECAPTCHA_KEY at build
 * time) Google's widget is rendered; otherwise Netlify injects its own.
 */
const siteKey =
  import.meta.env.PUBLIC_SITE_RECAPTCHA_KEY ||
  process.env.SITE_RECAPTCHA_KEY ||
  process.env.GATSBY_SITE_RECAPTCHA_KEY

const input =
  "min-h-14 w-full rounded-xl border border-tangerine bg-cream px-4 py-3 text-black outline-none transition-shadow focus:ring-2 focus:ring-tangerine md:min-h-18"
const label = "mb-2 block text-xs font-bold tracking-wide text-black uppercase"
---

<section class="flex flex-col items-center px-4 py-12">
  <form
    name="contact-page"
    method="POST"
    data-netlify="true"
    data-netlify-recaptcha="true"
    data-netlify-honeypot="bot-field"
    aria-label="Formularz kontaktowy"
    class="flex w-full flex-col items-center"
  >
    <input type="hidden" name="form-name" value="contact-page" />
    <input type="hidden" name="form-source" value="Ada" data-contact-source />
    <p hidden>
      <label>
        Nie wypełniaj tego pola: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="w-full max-w-2xl rounded-3xl border border-tangerine bg-petal px-6 py-8 shadow-xl sm:px-10 md:px-20 md:py-16">
      <label for="name" class={label}>
        Imię:
      </label>
      <input required type="text" name="name" id="name" autocomplete="given-name" class={input} />

      <label for="surname" class:list={[label, "mt-5"]}>
        Nazwisko:
      </label>
      <input
        required
        type="text"
        name="surname"
        id="surname"
        autocomplete="family-name"
        class={input}
      />

      <label for="email" class:list={[label, "mt-5"]}>
        Email:
      </label>
      <input required type="email" name="email" id="email" autocomplete="email" class={input} />

      <label for="message" class:list={[label, "mt-5"]}>
        Twoja wiadomość:
      </label>
      <textarea
        required
        name="message"
        id="message"
        rows="8"
        class:list={[input, "min-h-56 resize-y md:min-h-80"]}
      ></textarea>

      <div class="mt-6 flex items-start">
        <input
          required
          type="checkbox"
          id="consent"
          name="consent"
          class="mt-1 flex-none rounded border-black text-black focus:ring-tangerine"
        />
        <label for="consent" class="ml-3 text-xs leading-relaxed text-black">
          Wyrażam zgodę na przetwarzanie moich danych osobowych zgodnie z ustawą o ochronie danych
          osobowych w celu (np. wysyłania informacji handlowych). Podanie danych osobowych jest
          dobrowolne. Zostałem poinformowany, że przysługuje mi prawo dostępu do swoich danych,
          możliwości ich poprawiania, zadania zaprzestania ich przetwarzania. Administratorem danych
          jest Slow Marketing Adrianna Promis-Urbas z siedzibą w 47-400 Racibórz, Ul. Mała 2.
        </label>
      </div>

      <div class="mt-6 flex min-h-16 w-full justify-center overflow-hidden sm:min-h-20">
        {siteKey ? (
          <div class="g-recaptcha origin-top scale-85 sm:scale-100" data-sitekey={siteKey} />
        ) : (
          <div data-netlify-recaptcha="true" />
        )}
      </div>
    </div>

    <button
      type="submit"
      class="mt-10 w-full max-w-md rounded-lg bg-black px-7 py-3 font-anton text-xl font-normal tracking-wide text-white uppercase transition-transform hover:-translate-y-0.5 focus:ring-2 focus:ring-black focus:ring-offset-4 focus:ring-offset-mint focus:outline-none md:px-10 md:text-3xl"
    >
      Wyślij wiadomość!
    </button>
  </form>
</section>

{siteKey && <script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>}

<script>
  // Record which page/campaign sent the visitor here (?source=…).
  const source = new URLSearchParams(window.location.search).get("source")
  const field = document.querySelector<HTMLInputElement>("[data-contact-source]")
  if (source && field) field.value = source
</script>
